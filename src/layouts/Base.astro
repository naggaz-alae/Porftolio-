---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const {
  title = `${profile.name} · Data Analyst / Scientist / Engineer en alternance`,
  description = `${profile.role}. Je recherche une ${profile.availability.toLowerCase()}. Python, SQL, Machine Learning, Data Viz.`,
  type = 'website',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og-image.png`, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: new URL(base, Astro.site).href,
  sameAs: [profile.github, profile.linkedin].filter(Boolean),
  alumniOf: ['Université de Bordeaux', 'Efrei'],
  knowsAbout: ['Data Analysis', 'Machine Learning', 'Data Engineering', 'Python', 'SQL'],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#0b1120" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />

    <!-- OpenGraph (LinkedIn, WhatsApp, Slack…) -->
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      profile.goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${profile.goatcounter}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <nav class="container nav" aria-label="Navigation principale">
        <a class="brand" href={base}>AN<span>.</span></a>
        <ul>
          <li><a href={`${base}#projets`}>Projets</a></li>
          <li><a href={`${base}#parcours`}>Parcours</a></li>
          <li><a href={`${base}#a-propos`}>À propos</a></li>
          <li><a class="btn btn-sm" href={`${base}#contact`}>Contact</a></li>
        </ul>
      </nav>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} {profile.name} · Site construit avec Astro, hébergé sur GitHub Pages.</p>
      </div>
    </footer>
  </body>
</html>

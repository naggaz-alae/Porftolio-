---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Page introuvable">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Erreur 404</p>
      <h1>Cette donnée est <em>manquante</em>.</h1>
      <p class="lead">La page demandée n'existe pas ou a été déplacée.</p>
      <div class="actions"><a class="btn" href={base}>Retour à l'accueil</a></div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { profile, about, skills, projects, experience, education, languages } from '../data/profile';

const base = import.meta.env.BASE_URL;
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <p class="status">Disponible · {profile.availability}</p>
      <p class="eyebrow">{profile.name} · {profile.role}</p>
      <h1 id="hero-title">Je transforme des données brutes en <em>décisions</em>.</h1>
      <p class="lead">{profile.pitch}</p>
      <p class="hero-meta">📍 {profile.location} · 🗓️ {profile.rhythm}</p>
      <div class="actions">
        <a class="btn" href="#projets">Voir mes projets</a>
        <a class="btn btn-ghost" href={`mailto:${profile.email}?subject=Alternance%20Data`}>Me contacter</a>
        {profile.cv && <a class="btn btn-ghost" href={`${base}${profile.cv.replace(/^\//, '')}`} download>Télécharger mon CV</a>}
      </div>
    </div>
  </section>

  <section id="projets" aria-labelledby="projets-title">
    <div class="container">
      <p class="eyebrow">Projets</p>
      <h2 class="section-title" id="projets-title">Ce que j'ai construit</h2>
      <p class="lead">De la collecte de données au modèle déployé. Chaque projet est présenté avec la méthode STAR (situation, tâche, action, résultat).</p>
      <div class="grid">
        {
          projects.map((p) => (
            <article class="card project">
              <span class="emoji" aria-hidden="true">{p.emoji}</span>
              <h3>
                <a href={`${base}projets/${p.slug}/`}>{p.title}</a>
              </h3>
              <span class="kind">{p.kind}</span>
              <p>{p.summary}</p>
              <ul class="tags" aria-label="Technologies">
                {p.stack.map((t) => <li>{t}</li>)}
              </ul>
              <span class="more" aria-hidden="true">Lire l'étude de cas →</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="competences" aria-labelledby="competences-title">
    <div class="container">
      <p class="eyebrow">Compétences</p>
      <h2 class="section-title" id="competences-title">Ma boîte à outils data</h2>
      <div class="grid skills">
        {
          skills.map((s) => (
            <div class="card">
              <h3>{s.group}</h3>
              <ul class="tags">
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="parcours" aria-labelledby="parcours-title">
    <div class="container">
      <p class="eyebrow">Parcours</p>
      <h2 class="section-title" id="parcours-title">Expérience & formation</h2>
      <div class="two-cols">
        <div>
          <h3>Expérience</h3>
          <ol class="timeline">
            {
              experience.map((e) => (
                <li>
                  <span class="period">{e.period}</span>
                  <h3>{e.title}</h3>
                  <p class="org">{e.org}</p>
                  <ul>
                    {e.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                </li>
              ))
            }
          </ol>
        </div>
        <div>
          <h3>Formation</h3>
          <ol class="timeline">
            {
              education.map((e) => (
                <li>
                  <span class="period">{e.period}</span>
                  <h3>{e.title}</h3>
                  <p class="org">{e.org}</p>
                </li>
              ))
            }
          </ol>
          <h3>Langues</h3>
          <ul class="tags">
            {languages.map((l) => <li>{l}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="a-propos" class="about" aria-labelledby="about-title">
    <div class="container">
      <p class="eyebrow">À propos</p>
      <h2 class="section-title" id="about-title">Du développement à la donnée</h2>
      {about.map((para) => <p>{para}</p>)}
      <p>
        En dehors de la data : voyages et road trips, sport, veille sur les nouvelles tendances IA et engagement associatif.
      </p>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h2 class="section-title" id="contact-title">Construisons vos projets data ensemble</h2>
      <p class="lead">
        Je cherche une alternance de 24 mois à partir de septembre 2026 ({profile.rhythm}). Un échange de 15 minutes suffit pour voir si mon profil
        correspond à votre équipe.
      </p>
      <div class="actions">
        <a class="btn" href={`mailto:${profile.email}?subject=Alternance%20Data`}>✉️ {profile.email}</a>
        <a class="btn btn-ghost" href={profile.github} rel="me noopener" target="_blank">GitHub</a>
        {profile.linkedin && <a class="btn btn-ghost" href={profile.linkedin} rel="me noopener" target="_blank">LinkedIn</a>}
      </div>
    </div>
  </section>
</Base>

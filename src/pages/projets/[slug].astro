---
import Base from '../../layouts/Base.astro';
import { profile, projects, type Project } from '../../data/profile';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const base = import.meta.env.BASE_URL;
const repoIsProfile = project.repo.replace(/\/$/, '') === profile.github;
---

<Base title={`${project.title} · ${profile.name}`} description={project.summary} type="article">
  <section aria-labelledby="project-title">
    <div class="container">
      <a class="back" href={`${base}#projets`}>← Tous les projets</a>
      <p class="eyebrow">{project.kind}</p>
      <h1 id="project-title" class="section-title"><span aria-hidden="true">{project.emoji}</span> {project.title}</h1>
      <p class="lead">{project.summary}</p>
      <ul class="tags" aria-label="Technologies">
        {project.stack.map((t) => <li>{t}</li>)}
      </ul>
      <div class="actions">
        <a class="btn" href={project.repo} target="_blank" rel="noopener">
          {repoIsProfile ? 'Voir mon GitHub' : 'Voir le code sur GitHub'}
        </a>
        {project.demo && <a class="btn btn-ghost" href={project.demo} target="_blank" rel="noopener">Démo en ligne</a>}
      </div>

      <div class="star">
        <article class="card">
          <h2><span class="letter" aria-hidden="true">S</span> Situation</h2>
          <p>{project.star.situation}</p>
        </article>
        <article class="card">
          <h2><span class="letter" aria-hidden="true">T</span> Tâche</h2>
          <p>{project.star.task}</p>
        </article>
        <article class="card">
          <h2><span class="letter" aria-hidden="true">A</span> Actions</h2>
          <ul>
            {project.star.action.map((a) => <li>{a}</li>)}
          </ul>
        </article>
        <article class="card">
          <h2><span class="letter" aria-hidden="true">R</span> Résultat</h2>
          <p>{project.star.result}</p>
        </article>
      </div>
    </div>
  </section>
</Base>
